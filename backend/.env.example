# Copia este archivo como .env y completa los valores

# Base de datos (Railway lo configura automáticamente con PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Seguridad JWT (genera uno aleatorio: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-esto-por-una-clave-segura-aleatoria

# Orígenes permitidos (separados por coma, sin espacios)
# En Railway poner la URL de tu app: https://cmms-xxx.railway.app
ALLOWED_ORIGINS=https://cmms-xxx.railway.app,http://localhost:5173
